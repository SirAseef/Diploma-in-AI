*.zip
*.rar
*.7z

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Data & models (keep large files out of git) ---
data/raw/
data/large/
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.pkl
*.joblib
*.parquet
